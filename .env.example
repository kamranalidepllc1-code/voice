# Copy to .env.local (never commit .env.local). Server-side only — do NOT prefix with NEXT_PUBLIC_.

# Required: Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here


# Optional: TTS models to try in order. Free-tier quotas are per model, so when one model's
# daily quota is used up the next one is used automatically.
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts

# Optional: per-request timeout to Gemini in ms (default 240000; keep below the route's maxDuration of 300s)
# GEMINI_TTS_TIMEOUT_MS=240000

# Optional abuse/cost limits (in-memory, per server instance)
# TTS_MAX_REQUESTS_PER_MINUTE=120       # per IP, all TTS endpoints
# TTS_MAX_CHARS_PER_HOUR=120000         # per IP (~5 full 4,000-word generations)
# TTS_MAX_CONCURRENT_PER_IP=3
# TTS_GLOBAL_MAX_CHARS_PER_DAY=2000000  # whole server

# Testing only: override the Gemini API base URL (e.g. a local mock server)
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
